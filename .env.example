# PostgreSQL connection URL for Gnosis
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/gnosis_news?schema=public"

# Authentication Secrets (Phase 3)
# Generate a strong random key (e.g., openssl rand -base64 32)
AUTH_SECRET="your-32-character-random-secret-key-here"

# Initial Administrator Setup Placeholders (for local development / seeding)
ADMIN_EMAIL="admin@gnosis.news"
ADMIN_PASSWORD="change-this-secure-password"
